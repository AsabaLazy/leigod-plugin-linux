#!/bin/sh
# BusyBox-compatible `ps` wrapper for acc-gw.router.amd64 inside leigod_plugin.service.
# 1. Lists all processes (including TTY=? daemons) so `ps w` in DIAGNOSEACCENGINE works on procps-ng.
# 2. Filters out transient `ps`/`grep` subshells so `ps ax | grep ...` in AccProcessMgr never matches grep itself.
# 3. Reports a synthetic `acc_upgrade_monitor` entry when the updater is intentionally disabled.
set -u

printf '  PID TTY      STAT   TIME COMMAND\n'
found_updater=0

for pid_dir in /proc/[0-9]*; do
    pid=${pid_dir#/proc/}
    [ "$pid" != "$$" ] || continue
    [ -r "$pid_dir/cmdline" ] || continue
    cmd=$(tr '\0' ' ' < "$pid_dir/cmdline" 2>/dev/null || true)
    [ -n "$cmd" ] || continue
    case "$cmd" in
        *fake_ps*|*"ps w"*|*"ps ax"*|grep\ *|/usr/bin/grep\ *|/bin/grep\ *)
            continue
            ;;
        */opt/leigod/acc_upgrade_monitor*)
            found_updater=1
            ;;
    esac
    printf '%5s ?        S      0:00 %s\n' "$pid" "$cmd"
done

if [ "$found_updater" -eq 0 ]; then
    printf '99999 ?        S      0:00 /opt/leigod/acc_upgrade_monitor\n'
fi
